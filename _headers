# An ninh cho mọi trang.
# - HSTS: trình duyệt luôn dùng HTTPS (1 năm). Chưa bật preload: muốn bật thì thêm "; preload" và đăng ký hstspreload.org.
# - frame-ancestors / X-Frame-Options: không web nào khác nhúng được trang Bienac vào khung
#   (chặn trò giả trang ủng hộ, che nút bấm). CSP không giới hạn script để không vỡ các ứng dụng.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Trang nội bộ: không lưu đệm, không lên Google.
/stats/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/cong-cu/*
  X-Robots-Tag: noindex, nofollow

# Ảnh, logo, biểu tượng: gần như không đổi. Đổi nội dung thì đổi tên file (riêng ảnh QR: sửa cả mã băm trong scripts/theo-doi.mjs).
/assets/*
  Cache-Control: public, max-age=604800

# Font tự lưu: tên file cố định theo font, nội dung không bao giờ đổi.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS dùng chung: mọi trang gọi kèm dấu ?v= là mã băm nội dung file (scripts/dong-dau.mjs),
# nên lưu được 1 năm: file đổi thì dấu đổi, trình duyệt tải bản mới ngay.
# LƯU Ý: không gọi file trong /css, /js mà thiếu dấu ?v= (ví dụ nạp bằng JavaScript), kẻo trình duyệt giữ bản cũ.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=300
/*/du-lieu.json
  Cache-Control: public, max-age=3600

# Trang Hành trình nhân loại: thư viện three.js (1,2 MB) và ảnh bề mặt Trái Đất gần như không bao giờ đổi.
# Đổi nội dung thì đổi tên file.
/thegioi/libs/*
  Cache-Control: public, max-age=604800
/thegioi/assets/*
  Cache-Control: public, max-age=604800
